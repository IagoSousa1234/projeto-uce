<main class="conteudo-principal">

<form method="post" action="/cadastro/">


        <div class="login">

            <div class="login-container">

                <div class="foto">
                    <img src="/img/Kleber/Kleber_studio.jpg"
                        class="img-login"
                        alt="Foto">
                </div>

                <div class="dados">

                    <h1>Cadastra-se</h1>

                            {{#if erro}}
                                <p class="form-erro">{{erro}}</p>
                            {{/if}}


                    <input type="email" name="email" placeholder="Seu e-mail" value="{{valores.email}}" maxlength="100" autocomplete="email" required>
                    <input type="password" name="senha" placeholder="Crie uma senha (mín. 6 caracteres)" minlength="6" autocomplete="new-password" required>
                    <input type="password" name="confirmar" placeholder="Confirme a senha" minlength="6" autocomplete="new-password" required>
                    <input type="tel" name="telefone" placeholder="(99) 9 9999-9999" value="{{valores.telefone}}" maxlength="20" autocomplete="tel" required>

                    <p class="esqueci">Esqueci Minha Senha</p>

                <button type="submit" class="button-agendamento">Cadastrar</button>
                

            <div class="bottom">

            <div class="google-login">
                <img src="/icon/google.png" class="google" alt="">
                <span>Google</span>
            </div>

            <p class="criar">
                Já tem uma conta? <a href="/login"><strong>Entrar</strong></a>
            </p>

        </div>
                </div>

            </div>

        </div>

    </form>
</main>


